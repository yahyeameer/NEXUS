# Terrain tiles and textures live in git LFS (AGENTS.md §3)
data/terrain/**/*.tif filter=lfs diff=lfs merge=lfs -text
data/terrain/**/*.tiff filter=lfs diff=lfs merge=lfs -text
data/terrain/**/*.img filter=lfs diff=lfs merge=lfs -text
data/terrain/**/*.png filter=lfs diff=lfs merge=lfs -text
data/terrain/**/*.jpg filter=lfs diff=lfs merge=lfs -text
data/terrain/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
data/terrain/**/*.bin filter=lfs diff=lfs merge=lfs -text
data/evidence-packs/media/*.png filter=lfs diff=lfs merge=lfs -text
# Planet models (data/planets/<body>/...): NASA-derived glTF binaries
data/planets/**/*.glb filter=lfs diff=lfs merge=lfs -text

{
  "name": "nexus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./services/*\" --filter @nexus/xr dev",
    "dev:xr": "node scripts/devXr.mjs",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @nexus/xr test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "sie:redteam": "vitest run --project redteam --passWithNoTests",
    "dev:xr:client": "pnpm --filter @nexus/xr dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "globals": "^16.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}

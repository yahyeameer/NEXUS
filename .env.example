# Backend only — never expose to apps/xr
# Google Gemini for the voice gateway (field notes, grounded Q&A, briefing rewrites) and for the
# Docker Agent research team in agents/nexus.yaml (live mode)
GEMINI_API_KEY=
# Optional; both default to gemini-3.5-flash-lite
GEMINI_MODEL=
GEMINI_FAST_MODEL=
JEV_API_KEY=
JEV_BASE_URL=
# Optional; defaults to the pinned version in packages/sie/src/jevAdapter.ts
JEV_MODEL=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
OBJECT_STORAGE_URL=http://localhost:9000
NEXUS_MODE=precomputed   # precomputed | live
# Live research with docker-agent (services/orchestrator README "Live research with Docker Agent")
NEXUS_TEAM_CMD=pnpm --silent --dir services/orchestrator team
# Optional: "docker-agent" for the standalone binary; default "docker agent"
NEXUS_DOCKER_AGENT=
# "container" when Docker Desktop's MCP Gateway is not available (infra/Dockerfile.agents sets it)
NEXUS_AGENT_FLAVORS=
# Optional model override for every research agent, e.g. gemini-3.8-flash
NEXUS_GEMINI_MODEL=
NEXUS_TEAM_CONCURRENCY=3
# Live team timeout; defaults to 180000 (SECURITY_PRIVACY.md)
NEXUS_TEAM_TIMEOUT_MS=
XR_ORIGIN=https://localhost:5173
# services/api: headset pairing and backend service tokens (generate long random values)
NEXUS_PAIRING_CODE=
ORCHESTRATOR_TOKEN=
VOICE_GATEWAY_TOKEN=
